{
  "name": "backend",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "sync-env": "bun run scripts/sync-env-from-web.ts",
    "railway:set-openai": "bun run scripts/railway-set-openai.ts",
    "db:push": "bun run sync-env && bunx prisma db push",
    "studio": "bunx prisma studio",
    "typecheck": "tsc --noEmit",
    "test": "bun test src/lib/walks src/lib/dm-pair-key.test.ts src/lib/merge-users.test.ts src/lib/username.test.ts src/lib/workspace-access.test.ts",
    "test:merge-users": "MERGE_INTEGRATION=1 bun test src/lib/merge-users.integration.test.ts",
    "test:seneca-focus": "bun test src/lib/seneca-focus-engine.test.ts",
    "ensure:seneca-focus": "bun run scripts/ensure-seneca-team-brief.ts",
    "backfill:usernames": "bun run scripts/backfill-usernames.ts",
    "seed:cooler-walk": "bun run scripts/seed-cooler-walk.ts",
    "seed:people": "bun run scripts/seed-people-dev.ts seed",
    "seed:people:active": "bun run scripts/seed-people-dev.ts presence",
    "seed:people:cleanup": "bun run scripts/seed-people-dev.ts cleanup",
    "seed:people:dry-run": "bun run scripts/seed-people-dev.ts dry-run",
    "momentum:repair": "bun run scripts/repair-reset-momentum.ts"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/bun": "latest",
    "@types/pg": "^8.20.0",
    "prisma": "6",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "@hono/node-server": "1.12.0",
    "@hono/zod-validator": "^0.7.6",
    "@js-temporal/polyfill": "^0.5.1",
    "@prisma/client": "6",
    "bcryptjs": "^3.0.3",
    "better-auth": "1.4.18",
    "done": "^1.1.8",
    "firebase-admin": "^13.8.0",
    "hono": "4.6.0",
    "pg": "^8.22.0",
    "resend": "^6.10.0",
    "stripe": "^22.1.1",
    "unpdf": "^1.8.1",
    "zod": "4.1.11"
  }
}
